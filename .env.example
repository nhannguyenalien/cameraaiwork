# Copy to .env and fill in. Never commit the real .env.

# --- Camera ---
CAMERA_IP=192.168.2.23
CAMERA_ONVIF_PORT=2020
CAMERA_USERNAME=changeme
CAMERA_PASSWORD=changeme

# --- go2rtc ---
GO2RTC_URL=http://localhost:1984
# Public hostname the browser uses (e.g. your Cloudflare Tunnel hostname).
# Leave unset to fall back to GO2RTC_URL (fine for local-only testing).
PUBLIC_GO2RTC_URL=
GO2RTC_STREAM=tapo

# --- Web app ---
PORT=3021
DB_PATH=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local AI worker (ai/worker) ---
# Leave empty until the worker is deployed; every motion event is then
# treated as an alert (safe default, matches old behavior).
AI_WORKER_URL=
AI_WORKER_TIMEOUT_MS=3000

# --- RunPod (heavy GPU tasks, runpod/heavy-worker) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
