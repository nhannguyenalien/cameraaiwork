# secrets
.env
.dev.vars
apps/relay/cameras.json

# runtime state, not code — written by apps/relay/update.sh on every run
apps/relay/.update-status.json

# regenerated by scripts/build-relay-bundle.sh on every build
apps/relay/VERSION.json

# dependencies
node_modules/
.venv/
__pycache__/
*.pyc
apps/pages/_worker.bundle

# platform-specific binary + rendered config, generated by infra/setup.sh
infra/go2rtc/bin/
infra/go2rtc/go2rtc.yaml

# data / personal footage — never commit
data/*.db
data/clips/

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# local tooling
.claude/
apps/pages/.wrangler/
