<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps apps/relay (the on-site PTZ + motion-webhook process) running and
  restarts it on crash/reboot. macOS only — see infra/systemd for Linux.

  Install:
    cp com.cameraaiwork.relay.plist ~/Library/LaunchAgents/
    # edit the REPLACE_WITH_REPO_ROOT / REPLACE_WITH_NODE_PATH paths first
    # (find node's path with: which node)
    launchctl load ~/Library/LaunchAgents/com.cameraaiwork.relay.plist

  Logs: /tmp/cameraaiwork-relay.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cameraaiwork.relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_NODE_PATH</string>
    <string>REPLACE_WITH_REPO_ROOT/apps/relay/src/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO_ROOT/apps/relay</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/cameraaiwork-relay.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cameraaiwork-relay.log</string>
</dict>
</plist>
