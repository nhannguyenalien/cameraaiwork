<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the Node web app (apps/web) running and restarts it on crash/reboot.

  Install:
    cp com.cameraaiwork.web.plist ~/Library/LaunchAgents/
    # edit the REPLACE_WITH_REPO_ROOT / REPLACE_WITH_NODE_PATH paths first
    # (find node's path with: which node)
    launchctl load ~/Library/LaunchAgents/com.cameraaiwork.web.plist

  Logs: /tmp/cameraaiwork-web.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cameraaiwork.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_NODE_PATH</string>
    <string>REPLACE_WITH_REPO_ROOT/apps/web/src/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO_ROOT/apps/web</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/cameraaiwork-web.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cameraaiwork-web.log</string>
</dict>
</plist>
