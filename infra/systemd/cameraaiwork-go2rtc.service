[Unit]
Description=go2rtc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=REPLACE_WITH_REPO_ROOT/infra/go2rtc/bin/go2rtc -config REPLACE_WITH_REPO_ROOT/infra/go2rtc/go2rtc.yaml
Restart=always
RestartSec=5
User=REPLACE_WITH_USER

[Install]
WantedBy=multi-user.target
