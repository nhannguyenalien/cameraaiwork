[Unit]
Description=cameraaiwork local AI worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_WITH_REPO_ROOT/ai/worker
ExecStart=REPLACE_WITH_REPO_ROOT/ai/worker/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
User=REPLACE_WITH_USER

[Install]
WantedBy=multi-user.target
