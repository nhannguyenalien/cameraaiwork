# For local `wrangler pages dev` only. Copy to .dev.vars (gitignored).
# In production, set these in the Cloudflare dashboard:
#   Pages project -> Settings -> Environment variables (mark secrets as "Encrypted")
#
# Note: there is no global GO2RTC_URL / RELAY_URL / RELAY_SECRET / API_KEY
# here anymore — those are per-site (sites table) and per-account (api_keys
# table) rows in Turso now, not env vars. See schema.sql.

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Used by POST /api/sites to provision a real Cloudflare Named Tunnel per
# site server-side (our domain, customer needs neither their own Cloudflare
# account nor their own domain) — see functions/_lib/cloudflareTunnel.js.
# API Token needs Zone:DNS:Edit (scoped to the zone below) + Account:Cloudflare
# Tunnel:Edit. Create at https://dash.cloudflare.com/profile/api-tokens.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Base domain new site hostnames are minted under. A site "st-abc123" gets
# exactly one public hostname: "st-abc123.<this>". That hostname reaches the
# local relay; go2rtc and AI remain loopback-only behind it.
#
# IMPORTANT: this must be your zone's root domain (e.g. "yourdomain.com"),
# NOT a subdomain of it (e.g. NOT "camera.yourdomain.com") — even if that
# subdomain is already yours (e.g. a Pages custom domain). Cloudflare's
# zone-level Universal SSL wildcard only covers one level
# (*.yourdomain.com), so a tunnel hostname minted under an *already*
#-subdomained base (like "st-abc123.camera.yourdomain.com", two
# levels deep) falls outside it and gets no automatic certificate — every
# request fails at the TLS handshake, not with a clean HTTP error, which
# made this genuinely confusing to diagnose the first time. Real incident:
# this was set to "camera.schoolsai.work" initially (the dashboard's own
# subdomain), every tunnel hostname failed TLS, fixed by using
# "schoolsai.work" directly instead. See docs/PLAN.md.
TUNNEL_BASE_DOMAIN=yourdomain.com

# Hourly cleanup/quota monitor. Keep this separate from customer API keys.
MAINTENANCE_SECRET=replace-with-a-long-random-secret
# Operational warning thresholds, not claimed vendor hard limits.
MANAGED_TUNNEL_WARN_AT=900
MANAGED_DNS_WARN_AT=900
ORPHAN_TUNNEL_GRACE_HOURS=6

# CORS for the API — comma-separated origins, or "*" for any (fine even
# wide open since auth is a bearer token, not a cookie).
ALLOWED_ORIGINS=*

# 32 random bytes encoded as base64. Used to encrypt customer-owned
# Telegram/RunPod credentials stored per account. Never rotate this key
# without first re-encrypting all account_integrations rows.
CUSTOMER_SECRETS_KEY=

# Platform-owned billing credentials. Customers never enter these values.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# One platform-owned Google OAuth client, shared by every account, so a
# customer can connect their own Google Drive for event storage without
# creating anything in Google Cloud themselves — see
# functions/_lib/googleAuth.js and functions/api/settings/storage-config/.
# Setup in Google Cloud Console (console.cloud.google.com):
#   1. APIs & Services -> Library -> enable "Google Drive API".
#   2. APIs & Services -> OAuth consent screen -> External -> fill app name/
#      support email -> add scope ".../auth/drive" -> while in "Testing"
#      publishing status, add every Google account that will connect a
#      Drive as a test user (or "Publish app" to allow any Google account,
#      which may require Google's verification review for this scope).
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client
#      ID -> Application type "Web application" -> Authorized redirect URIs:
#      add exactly "https://<your-pages-domain>/api/settings/storage-config/google-callback"
#      (and the localhost equivalent for `wrangler pages dev` if testing
#      locally, e.g. "http://localhost:8788/api/settings/storage-config/google-callback").
#   4. Copy the resulting Client ID / Client secret below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SchoolsAI powers the public customer-support bot and is the preferred
# dashboard operator. Keep the real key in Cloudflare secrets/.dev.vars only.
SCHOOLSAI_API_KEY=
SCHOOLSAI_BASE_URL=https://apic.schoolsai.work
