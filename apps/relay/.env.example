# Copy to .env on the on-site machine. Never commit the real .env.
# Camera credentials go in cameras.json (copy from cameras.json.example),
# not here — a site can run more than one camera.
#
# Normally you won't hand-write this file at all — apps/relay/install.sh
# generates it for you from the Cloudflare Pages API.

SITE_ID=st-nhachinh01
RELAY_PORT=4000
RELAY_SECRET=changeme-must-match-sites.relay_secret-in-turso

GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_RTSP_URL=rtsp://127.0.0.1:8554
GO2RTC_RECONCILE_INTERVAL_MS=15000
PERSON_POLL_MAX_CONCURRENCY=3

# Optional Tapo native talkback. This is the Tapo/TP-Link password accepted
# by tapo://, and is used to play TAPO_GREETING once when a person arrives.
TAPO_TALKBACK_PASSWORD=
TAPO_GREETING=Xin chào
TAPO_GREETING_COOLDOWN_MS=60000

# Your Cloudflare Pages deployment. The relay derives MOTION_WEBHOOK_URL
# from this — override individually only if you need something different
# (e.g. a preview deploy).
PAGES_API_URL=https://cameraaiwork.pages.dev

# Premium GPU face grouping runs beside local grouping. Use 0 to disable it.

# If POST /api/sites provisioned a real named tunnel (the backend has
# CLOUDFLARE_API_TOKEN configured), this is its token — the relay runs
# `cloudflared tunnel run --token` instead of a Quick Tunnel, and doesn't
# need to self-report its URL since the hostname is already stable and in
# the DB. Leave empty to fall back to Quick Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Windows only — full path to cloudflared.exe (no PATH convention there
# like macOS/Linux have via brew/`/usr/local/bin`).
CLOUDFLARED_BIN=
